#* /---*---*---*---*---*---*---*---*/
#* .env.example (サンプルファイル)
#* /---*---*---*---*---*---*---*---*/
BRAWL_TOKEN="<brawl_stars_api_key>"

SESSION_SECRET_KEY="<session_secret_key>"
LOG_LEVEL="DEBUG"

# ログローテーション設定
TIMEDROTATING=True

# Redis用の設定
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD="<redis_password>"
REDIS_DB=0

# PostgreSQL用の設定
DB_HOST="localhost"
DB_PORT=5432
DB_USER="brawl_insights_user"
DB_PASSWORD="<db_password>"
DB_NAME="brawl_insights_db"

# セッションクッキーをHTTPS経由でのみ送信するかどうか (本番環境ではTrueにする)
# SESSION_HTTPS_ONLY=True

# Google Analytics Measurement ID (Googleアナリティクス)
# GA_MEASUREMENT_ID="<ga_measurement_id>"

# RevenueCat Webhookの認証トークン
REVENUECAT_WEBHOOK_AUTH="<revenuecat_webhook_auth>"

# 自宅IPを設定 (広告をテストモードにする)
HOME_IP=<home_ip_adress>

# バトル履歴の保存期間（月数）。未設定時は4（本番デフォルト）
# DEFAULT_BATTLE_LOG_RETENTION_MONTHS=1
# アーカイブバトル履歴の保存期間（月数）。未設定時は12（本番デフォルト）
# ARCHIVE_RETENTION_MONTHS=2